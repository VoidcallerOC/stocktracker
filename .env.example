# Server-only. Never expose these to the browser bundle.
APP_ENV=development              # development | preview | production

# Ingestion kill switches (1 = stop)
INGEST_KILL_ALL=0
# INGEST_KILL_<SOURCE_ID>=1      e.g. INGEST_KILL_BESTBUY_DEVELOPER_API=1

# Source enable flags. A flag alone does NOT allow a source to run: its registry
# authorizationStatus must also be VERIFIED (src/domain/sources.js).
SOURCE_COMMUNITY_ENABLED=0
SOURCE_BESTBUY_ENABLED=0
SOURCE_WALMART_ENABLED=0
SOURCE_TARGET_ENABLED=0
SOURCE_GAMESTOP_ENABLED=0
SOURCE_SYNTHETIC_DEMO_ENABLED=0  # dev/test only; blocked in production

# Notifications (off by default) + global kill switch
NOTIFICATIONS_ENABLED=0
NOTIFICATIONS_KILL=0

# Credentials (none issued yet)
# BESTBUY_API_KEY=
# TEST_DATABASE_URL=postgres://postgres@localhost:54329/st_test   # local throwaway DB only
